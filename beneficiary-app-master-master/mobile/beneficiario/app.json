{
  "expo": {
    "name": "IPROSS Beneficiarios",
    "slug": "ipross-beneficiarios",
    "version": "1.5.0",
    "orientation": "portrait",
    "scheme": "iprossbeneficiarios",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f5f5f5",
    "splash": {
      "image": "./app/images/ipross_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f5f5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
  "bundleIdentifier": "com.ipross.rionegro"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ipross.rionegro",
      "versionCode": 10,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "com.google.android.c2dm.permission.RECEIVE"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación accede a tus fotos para que puedas adjuntar documentación.",
          "cameraPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true,
            "gradleVersion": "8.8",
            "androidGradlePluginVersion": "8.3.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "24a14609-ea03-45f1-80be-15862953ee97"
      }
    },
    "owner": "fibonaku"
  }
}
