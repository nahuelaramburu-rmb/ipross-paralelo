{
  "expo": {
    "name": "IPROSS Beneficiarios",
    "slug": "ipross-beneficiarios",
    "version": "1.3.2",
    "orientation": "portrait",
    "scheme": "iprossbeneficiarios",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#6ac64f",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#6ac64f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beneficiario"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.beneficiario",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 33,
            "targetSdkVersion": 33,
            "buildToolsVersion": "33.0.1"
          },
          "ios": {
            "deploymentTarget": "13.4"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "24a14609-ea03-45f1-80be-15862953ee97"
      }
    },
    "owner": "fibonaku"
  }
}
