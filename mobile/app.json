{
  "expo": {
    "name": "IPROSS Beta - Acceso Anticipado",
    "slug": "ipross-beta-anticipado",
    "version": "1.9.0",
    "orientation": "portrait",
    "scheme": "ipross-beneficiarios",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#f5f5f5",
    "splash": {
      "image": "./app/images/ipross_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5f5f5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
  "bundleIdentifier": "com.iprossbeta.anticipado"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.iprossbeta.anticipado",
      "versionCode": 14,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.DETECT_SCREEN_CAPTURE",
        "com.google.android.c2dm.permission.RECEIVE",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La aplicación accede a tus fotos para que puedas adjuntar documentación.",
          "cameraPermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true,
            "gradleVersion": "8.8",
            "androidGradlePluginVersion": "8.3.0",
            "newArchEnabled": false
          },
          "ios": {
            "deploymentTarget": "15.1",
            "newArchEnabled": false
          }
        }
      ]
    ],
    "owner": "fibonaku",
    "extra": {
      "eas": {
        "projectId": "81c8345d-d765-4441-908b-dc7211129d11"
      }
    }
  }
}
